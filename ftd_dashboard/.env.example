# NASA FIRMS MAP_KEY (free): https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Enables VIIRS (S-NPP, NOAA-20, NOAA-21), MODIS NRT and the historical (SP) archive.
FIRMS_MAP_KEY=

# Copernicus Data Space Ecosystem Sentinel Hub OAuth client (free):
# https://shapps.dataspace.copernicus.eu/dashboard/#/account/settings  -> OAuth clients
# Enables Sentinel-2 NDVI/NBR change and Sentinel-1 SAR backscatter change.
# Sentinel-3 SLSTR FRP granule discovery works without credentials.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Optional overrides
FIREVERIFY_DB=data/fireverify.db
# Likelihood table for the naive Bayes verifier (written by `calibrate`; expert defaults if missing)
FIREVERIFY_LIKELIHOODS=data/likelihoods.json
# Comma-separated GeoJSON files with contextual layers (each feature needs properties.category)
FIREVERIFY_CONTEXT_PATHS=
# Set to 0 to skip OpenStreetMap Overpass lookups for industrial/flare/volcano context
FIREVERIFY_OVERPASS=1

# Dashboard admin password. Required for all POST routes when the server
# binds on a public interface (Render, 0.0.0.0). Send as
# Authorization: Bearer <token>, HTTP Basic (password = token), or X-Admin-Token.
FTD_ADMIN_TOKEN=

# Optional: gzipped or raw SQLite downloaded at start when FIREVERIFY_DB is missing.
# Use a GitHub release asset URL (the uncompressed DB is over GitHub's 100 MB file cap).
FIREVERIFY_DB_URL=

# Optional: folder with the burning-activity country archive (default: data/external/burning_activity_calendar)
# FIREVERIFY_COUNTRY_ARCHIVE=data/external/burning_activity_calendar
